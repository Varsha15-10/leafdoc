name: Build LeafDoc APK
on:
  workflow_dispatch:
permissions:
  contents: write
jobs:
  build:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - name: Unzip the project
        run: unzip -q leafdoc-android.zip
      - uses: actions/setup-java@v4
        with:
          distribution: temurin
          java-version: "17"
      - uses: gradle/actions/setup-gradle@v4
        with:
          gradle-version: "8.7"
      - name: Build the APK
        working-directory: leafdoc-android/android
        run: gradle assembleDebug
      - name: Publish the APK as a release
        env:
          GH_TOKEN: ${{ secrets.GITHUB_TOKEN }}
        run: |
          cp leafdoc-android/android/app/build/outputs/apk/debug/app-debug.apk LeafDoc.apk
          gh release create "apk-${{ github.run_number }}" LeafDoc.apk --title "LeafDoc APK" --notes "Debug build"
